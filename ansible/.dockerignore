# Docker reads .dockerignore only from the build-context root. The Compose
# services in this directory use ansible/ as their build context
# (ansible/docker-compose.yml), so this file governs those builds — not the
# repository-root .dockerignore. Exclusions mirror the root file; `keys/` is
# the context-relative path of ansible/keys/ generated by scripts/init.sh.
ansible/keys/
keys/
**/.vault_pass
**/vars/vault.yml
.local/
.git/
*.log
**/*.log
